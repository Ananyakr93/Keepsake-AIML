# Copy to .env. These match the isolated local development database in scripts/setup-db.sh.
DATABASE_URL=postgresql://aiml:aiml-local-dev@localhost:5433/aiml_el
MONGO_URL=mongodb://localhost:27017
MONGO_DB=aiml_el
DEFAULT_USERNAME=aiml
# Optional: point to your local jinaai/jina-embeddings-v5-omni-small model directory.
EMBED_MODEL_DIR=

# Dataset screenshots are embedded locally even if cloud processing is enabled.
# The optional memory pipeline can send non-dataset images and captions to OpenAI.
ALLOW_CLOUD_PROCESSING=false
OPENAI_API_KEY=
# Comma-separated exact domains and their subdomains, e.g. bank.example,mail.example
BLOCKED_ACTIVITY_DOMAINS=
# Optional live models. Enable session admission after training from reviewed CSVs.
AIML_USE_SESSION_ADMISSION=false
# AIML_SESSION_MODELS=data/experiments/reviewed/session_models.joblib
# baseline | weighted | learned | xgboost | cross_encoder
AIML_RANKER=xgboost
